<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>GNG TEAM — توسعه دیجیتال</title>
<meta name="description" content="GNG TEAM — مجموعه‌ای از توسعه‌دهندگان مستقل برای طراحی وب‌سایت، ساخت ربات روبیکا و توسعه پروژه‌های هوشمند." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  :root{
    --bg: #ffffff;
    --bg-soft: #f7f8fc;
    --bg-soft-2: #eef1f9;
    --text: #0f172a;
    --text-muted: #5b6478;
    --line: #e6e9f2;
    --brand: #4f46e5;
    --brand-2: #06b6d4;
    --brand-3: #8b5cf6;
    --shadow-sm: 0 2px 8px rgba(15,23,42,.05);
    --shadow-md: 0 10px 30px rgba(15,23,42,.08);
    --shadow-lg: 0 24px 60px rgba(79,70,229,.14);
    --radius: 20px;
  }

  *{ box-sizing: border-box; margin: 0; padding: 0; }

  html{ scroll-behavior: smooth; }

  body{
    font-family: 'Vazirmatn', system-ui, -apple-system, 'Segoe UI', Tahoma, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.85;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  a{ color: inherit; text-decoration: none; }
  ul{ list-style: none; }
  img, svg{ display: block; max-width: 100%; }

  .container{
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 22px;
  }

  /* ===== Decorative background blobs ===== */
  .bg-decor{
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .blob{
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: .35;
  }
  .blob.b1{ width: 520px; height: 520px; top: -180px; right: -140px; background: radial-gradient(circle at 30% 30%, #c7d2fe, transparent 70%); }
  .blob.b2{ width: 460px; height: 460px; top: 40%; left: -180px; background: radial-gradient(circle at 70% 70%, #cffafe, transparent 70%); }
  .blob.b3{ width: 400px; height: 400px; bottom: -140px; right: 30%; background: radial-gradient(circle at 50% 50%, #ede9fe, transparent 70%); }

  /* ===== Header ===== */
  header{
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: rgba(255,255,255,.78);
    border-bottom: 1px solid transparent;
    transition: border-color .3s ease, box-shadow .3s ease;
  }
  header.scrolled{
    border-bottom-color: var(--line);
    box-shadow: var(--shadow-sm);
  }
  .nav{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    height: 74px;
  }
  .logo{
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 1.12rem;
    letter-spacing: -.3px;
  }
  .logo-mark{
    width: 40px; height: 40px;
    border-radius: 12px;
    display: grid; place-items: center;
    background: linear-gradient(135deg, var(--brand), var(--brand-3) 55%, var(--brand-2));
    box-shadow: 0 8px 20px rgba(79,70,229,.28);
  }
  .logo-mark svg{ width: 22px; height: 22px; }
  .logo-text small{
    display: block;
    font-size: .68rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: .4px;
    line-height: 1;
    margin-top: 2px;
  }

  .nav-links{
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav-links a{
    padding: 9px 14px;
    border-radius: 10px;
    font-size: .93rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color .2s ease, background .2s ease;
  }
  .nav-links a:hover{ color: var(--brand); background: var(--bg-soft); }

  .btn{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 22px;
    border-radius: 12px;
    font-family: inherit;
    font-size: .95rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: transform .2s ease, box-shadow .25s ease, background .25s ease, color .2s ease;
    white-space: nowrap;
  }
  .btn svg{ width: 18px; height: 18px; }
  .btn-primary{
    color: #fff;
    background: linear-gradient(135deg, var(--brand), var(--brand-3));
    box-shadow: 0 10px 24px rgba(79,70,229,.28);
  }
  .btn-primary:hover{ transform: translateY(-2px); box-shadow: 0 16px 34px rgba(79,70,229,.36); }
  .btn-ghost{
    color: var(--text);
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }
  .btn-ghost:hover{ border-color: #c7cdf5; color: var(--brand); transform: translateY(-2px); }

  .nav-toggle{
    display: none;
    width: 44px; height: 44px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #fff;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }
  .nav-toggle svg{ width: 22px; height: 22px; }

  /* ===== Hero ===== */
  .hero{
    padding: 74px 0 60px;
    position: relative;
  }
  .hero-grid{
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 56px;
    align-items: center;
  }
  .badge{
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 999px;
    background: linear-gradient(135deg, #eef2ff, #ecfeff);
    border: 1px solid #e0e7ff;
    font-size: .8rem;
    font-weight: 600;
    color: var(--brand);
    margin-bottom: 22px;
  }
  .badge .dot{
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 4px rgba(34,197,94,.16);
    animation: pulse 2s infinite;
  }
  @keyframes pulse{
    0%,100%{ box-shadow: 0 0 0 4px rgba(34,197,94,.16); }
    50%{ box-shadow: 0 0 0 8px rgba(34,197,94,.06); }
  }

  .hero h1{
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: -.8px;
    margin-bottom: 18px;
  }
  .grad-text{
    background: linear-gradient(120deg, var(--brand), var(--brand-3) 45%, var(--brand-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .hero p.lead{
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 520px;
    margin-bottom: 30px;
  }
  .hero-actions{
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 34px;
  }
  .hero-stats{
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .stat{
    padding: 12px 18px;
    border-radius: 14px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    min-width: 118px;
  }
  .stat b{
    display: block;
    font-size: 1.25rem;
    font-weight: 800;
    background: linear-gradient(120deg, var(--brand), var(--brand-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.4;
  }
  .stat span{
    font-size: .78rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Hero illustration */
  .hero-art{
    position: relative;
    display: grid;
    place-items: center;
  }
  .hero-art .glow{
    position: absolute;
    width: 82%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(139,92,246,.18), rgba(6,182,212,.10) 45%, transparent 70%);
    filter: blur(24px);
  }
  .hero-svg{
    width: 100%;
    max-width: 520px;
    position: relative;
    animation: floaty 7s ease-in-out infinite;
  }
  @keyframes floaty{
    0%,100%{ transform: translateY(0); }
    50%{ transform: translateY(-14px); }
  }
  .float-chip{
    position: absolute;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 9px 13px;
    box-shadow: var(--shadow-md);
    font-size: .76rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    animation: floaty 6s ease-in-out infinite;
  }
  .float-chip .ic{
    width: 24px; height: 24px;
    border-radius: 8px;
    display: grid; place-items: center;
    background: linear-gradient(135deg, #eef2ff, #ecfeff);
  }
  .float-chip .ic svg{ width: 14px; height: 14px; }
  .chip-1{ top: 8%; left: -4%; animation-delay: .4s; }
  .chip-2{ bottom: 12%; right: -3%; animation-delay: 1.2s; }
  .chip-3{ top: 46%; right: -8%; animation-delay: 2s; }

  /* ===== Sections ===== */
  section{ padding: 68px 0; }

  .section-head{
    text-align: center;
    max-width: 680px;
    margin: 0 auto 46px;
  }
  .eyebrow{
    display: inline-block;
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .6px;
    color: var(--brand);
    background: #eef2ff;
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 14px;
  }
  .section-head h2{
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -.5px;
    line-height: 1.45;
    margin-bottom: 12px;
  }
  .section-head p{
    color: var(--text-muted);
    font-size: .98rem;
  }

  .divider-svg{
    display: flex;
    justify-content: center;
    opacity: .9;
    margin: 0 auto;
  }

  /* About */
  .about-wrap{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 46px;
    align-items: center;
    background: linear-gradient(180deg, #ffffff, var(--bg-soft));
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: 44px;
    box-shadow: var(--shadow-sm);
  }
  .about-wrap h3{
    font-size: 1.45rem;
    font-weight: 800;
    margin-bottom: 14px;
    letter-spacing: -.4px;
  }
  .about-wrap p{ color: var(--text-muted); font-size: .97rem; }
  .about-list{
    margin-top: 22px;
    display: grid;
    gap: 12px;
  }
  .about-list li{
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: .93rem;
    color: #334155;
    font-weight: 500;
  }
  .about-list .tick{
    flex: 0 0 auto;
    width: 22px; height: 22px;
    border-radius: 50%;
    display: grid; place-items: center;
    background: linear-gradient(135deg, #dcfce7, #d1fae5);
    margin-top: 4px;
  }
  .about-list .tick svg{ width: 12px; height: 12px; }
  .about-art{ display: grid; place-items: center; }

  /* Services */
  .cards{
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .card{
    position: relative;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 30px 26px;
    box-shadow: var(--shadow-sm);
    transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    overflow: hidden;
  }
  .card::before{
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--brand), var(--brand-3), var(--brand-2));
    transform: scaleX(0);
    transform-origin: right;
    transition: transform .4s ease;
  }
  .card:hover{
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: #dfe3f5;
  }
  .card:hover::before{ transform: scaleX(1); }

  .card-icon{
    width: 58px; height: 58px;
    border-radius: 16px;
    display: grid; place-items: center;
    margin-bottom: 20px;
    background: linear-gradient(135deg, #eef2ff, #f5f3ff);
    border: 1px solid #e6e9fa;
    transition: transform .3s ease;
  }
  .card:hover .card-icon{ transform: rotate(-6deg) scale(1.05); }
  .card-icon svg{ width: 28px; height: 28px; }

  .card h3{
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 10px;
    letter-spacing: -.3px;
  }
  .card p{
    font-size: .9rem;
    color: var(--text-muted);
    line-height: 1.9;
  }

  /* Games */
  .games{
    background: linear-gradient(180deg, var(--bg-soft), #ffffff);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .games-grid{
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
  }
  .game-card{
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 24px 18px;
    text-align: center;
    box-shadow: var(--shadow-sm);
    transition: transform .28s ease, box-shadow .28s ease, border-color .28s;
    cursor: pointer;
  }
  .game-card:hover{
    transform: translateY(-8px);
    box-shadow: var(--shadow-md);
    border-color: #dfe3f5;
  }
  .game-icon{
    width: 62px; height: 62px;
    margin: 0 auto 16px;
    border-radius: 18px;
    display: grid; place-items: center;
    transition: transform .3s ease;
  }
  .game-card:hover .game-icon{ transform: scale(1.08) rotate(4deg); }
  .game-icon svg{ width: 32px; height: 32px; }

  .gi-1{ background: linear-gradient(135deg,#eef2ff,#e0e7ff); }
  .gi-2{ background: linear-gradient(135deg,#fef3c7,#fde68a); }
  .gi-3{ background: linear-gradient(135deg,#dcfce7,#bbf7d0); }
  .gi-4{ background: linear-gradient(135deg,#e0f2fe,#bae6fd); }
  .gi-5{ background: linear-gradient(135deg,#fce7f3,#fbcfe8); }

  .game-card h4{
    font-size: .98rem;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .game-card span{
    font-size: .76rem;
    color: var(--text-muted);
    line-height: 1.7;
    display: block;
  }

  /* Contact */
  .contact-box{
    position: relative;
    overflow: hidden;
    border-radius: 30px;
    padding: 56px 44px;
    text-align: center;
    background:
      radial-gradient(900px 320px at 50% -40%, rgba(139,92,246,.16), transparent 70%),
      linear-gradient(180deg, #ffffff, var(--bg-soft));
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
  }
  .contact-box h2{
    font-size: clamp(1.5rem, 3vw, 2.05rem);
    font-weight: 800;
    letter-spacing: -.5px;
    margin-bottom: 12px;
  }
  .contact-box p{
    color: var(--text-muted);
    font-size: .97rem;
    max-width: 520px;
    margin: 0 auto 30px;
  }
  .contact-actions{
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    margin-bottom: 34px;
  }
  .contact-actions .btn{ min-width: 200px; }

  .contact-info{
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }
  .info-chip{
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 11px 18px;
    font-size: .88rem;
    font-weight: 600;
    box-shadow: var(--shadow-sm);
    transition: transform .22s ease, border-color .22s;
  }
  .info-chip:hover{ transform: translateY(-3px); border-color: #c7cdf5; }
  .info-chip svg{ width: 18px; height: 18px; }
  .info-chip .lbl{ color: var(--text-muted); font-weight: 500; font-size: .8rem; }

  /* Footer */
  footer{
    padding: 40px 0 34px;
    border-top: 1px solid var(--line);
    background: #fff;
  }
  .footer-inner{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .footer-inner p{
    font-size: .85rem;
    color: var(--text-muted);
  }
  .footer-links{
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
  .footer-links a{
    font-size: .85rem;
    color: var(--text-muted);
    transition: color .2s;
  }
  .footer-links a:hover{ color: var(--brand); }

  /* Reveal animation */
  .reveal{
    opacity: 0;
    transform: translateY(26px);
    transition: opacity .7s cubic-bezier(.22,1,.36,1), transform .7s cubic-bezier(.22,1,.36,1);
  }
  .reveal.in{ opacity: 1; transform: none; }

  /* ===== Responsive ===== */
  @media (max-width: 1024px){
    .hero-grid{ grid-template-columns: 1fr; gap: 40px; }
    .hero-art{ order: -1; max-width: 460px; margin: 0 auto; }
    .hero p.lead{ margin-inline: auto; }
    .hero{ text-align: center; }
    .hero-actions, .hero-stats{ justify-content: center; }
    .badge{ margin-inline: auto; }
    .about-wrap{ grid-template-columns: 1fr; padding: 34px; }
    .about-art{ order: -1; max-width: 420px; }
    .cards{ grid-template-columns: repeat(2, 1fr); }
    .games-grid{ grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 820px){
    .nav-links{
      position: absolute;
      top: 74px;
      right: 0; left: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 14px 22px 20px;
      background: #fff;
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-md);
      display: none;
    }
    .nav-links.open{ display: flex; }
    .nav-links a{ padding: 12px 14px; }
    .nav-toggle{ display: inline-flex; }
    .nav .btn-primary{ display: none; }
    .nav-links .mobile-cta{
      margin-top: 8px;
      display: block;
      text-align: center;
      color: #fff;
      background: linear-gradient(135deg, var(--brand), var(--brand-3));
      border-radius: 12px;
      font-weight: 600;
    }
  }

  @media (max-width: 640px){
    section{ padding: 52px 0; }
    .hero{ padding: 44px 0 40px; }
    .cards{ grid-template-columns: 1fr; }
    .games-grid{ grid-template-columns: repeat(2, 1fr); }
    .about-wrap{ padding: 26px 22px; border-radius: 22px; }
    .contact-box{ padding: 40px 22px; border-radius: 22px; }
    .contact-actions .btn{ width: 100%; }
    .float-chip{ display: none; }
    .footer-inner{ justify-content: center; text-align: center; }
    .stat{ flex: 1 1 40%; text-align: center; }
    .hero-stats{ width: 100%; }
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation: none !important; transition: none !important; }
    .reveal{ opacity: 1; transform: none; }
  }
</style>
</head>
<body>

<!-- ===== Background decoration ===== -->
<div class="bg-decor" aria-hidden="true">
  <span class="blob b1"></span>
  <span class="blob b2"></span>
  <span class="blob b3"></span>
</div>

<!-- ===== Header ===== -->
<header id="site-header">
  <div class="container">
    <nav class="nav">
      <a href="#home" class="logo" aria-label="GNG TEAM">
        <span class="logo-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 8l-4 4 4 4"/>
            <path d="M16 8l4 4-4 4"/>
            <path d="M13.5 5l-3 14"/>
          </svg>
        </span>
        <span class="logo-text">
          GNG TEAM
          <small>توسعه دیجیتال</small>
        </span>
      </a>

      <ul class="nav-links" id="navLinks">
        <li><a href="#about">درباره ما</a></li>
        <li><a href="#services">خدمات</a></li>
        <li><a href="#games">بازی‌ها و ابزارها</a></li>
        <li><a href="#contact">ارتباط با ما</a></li>
        <li><a href="#contact" class="mobile-cta">شروع همکاری</a></li>
      </ul>

      <a href="#contact" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/>
        </svg>
        گفتگو با ما
      </a>

      <button class="nav-toggle" id="navToggle" aria-label="منو" aria-expanded="false" aria-controls="navLinks">
        <svg viewBox="0 0 24 24" fill="none" stroke="#0f172a" stroke-width="2" stroke-linecap="round">
          <path d="M3 6h18M3 12h18M3 18h18"/>
        </svg>
      </button>
    </nav>
  </div>
</header>

<main>
  <!-- ===== Hero ===== -->
  <section class="hero" id="home">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy reveal">
          <span class="badge">
            <span class="dot"></span>
            GNG TEAM — توسعه دیجیتال
          </span>

