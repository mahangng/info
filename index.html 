<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>GNG TEAM | توسعه دیجیتال</title>
<meta name="description" content="GNG TEAM - طراحی وب‌سایت، ساخت ربات روبیکا و توسعه پروژه‌های دیجیتال" />
<style>
  :root {
    --white: #ffffff;
    --light: #f8fafc;
    --light-border: #e2e8f0;
    --dark: #0f172a;
    --dark-2: #111827;
    --card-dark: #1e293b;
    --text-dark: #e2e8f0;
    --muted-dark: #94a3b8;
    --accent: #38bdf8;
    --accent-2: #818cf8;
    --border-dark: #334155;
    --text-light: #0f172a;
    --muted-light: #475569;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: Tahoma, Vazirmatn, "Segoe UI", sans-serif;
    background: var(--dark);
    color: var(--text-dark);
    line-height: 1.9;
    overflow-x: hidden;
  }

  a { color: inherit; text-decoration: none; }

  /* ============ HERO - WHITE THEME ============ */
  .hero {
    position: relative;
    background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 70%, #0f172a 100%);
    padding: 60px 20px 140px;
    overflow: hidden;
    color: var(--text-light);
    text-align: center;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 15% 20%, rgba(56, 189, 248, 0.15), transparent 40%),
      radial-gradient(circle at 85% 30%, rgba(129, 140, 248, 0.15), transparent 40%);
    pointer-events: none;
  }

  .hero-inner {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .logo-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    border: 1px solid var(--light-border);
    padding: 8px 18px 8px 14px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: bold;
    color: var(--text-light);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    margin-bottom: 24px;
  }

  .logo-badge .dot {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
  }

  .hero h1 {
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.4;
    color: var(--text-light);
    margin-bottom: 16px;
    font-weight: 900;
    letter-spacing: -0.5px;
  }

  .hero h1 .grad {
    background: linear-gradient(90deg, #0ea5e9, #6366f1);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero p.sub {
    color: var(--muted-light);
    font-size: 1rem;
    max-width: 640px;
    margin: 0 auto 32px;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-bottom: 40px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    border-radius: 12px;
    font-weight: bold;
    font-size: 0.95rem;
    transition: transform .15s ease, box-shadow .15s ease, background .2s ease;
    cursor: pointer;
    border: none;
  }

  .btn:hover { transform: translateY(-2px); }

  .btn-primary {
    background: linear-gradient(90deg, #0ea5e9, #6366f1);
    color: #fff;
    box-shadow: 0 8px 24px rgba(14, 165, 233, 0.35);
  }

  .btn-primary:hover { box-shadow: 0 12px 30px rgba(14, 165, 233, 0.5); }

  .btn-ghost {
    background: #ffffff;
    color: var(--text-light);
    border: 1px solid var(--light-border);
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
  }

  .btn-ghost:hover { background: #f8fafc; }

  /* SVG illustration in hero */
  .hero-art {
    position: relative;
    max-width: 560px;
    margin: 0 auto;
    margin-top: 10px;
  }

  .hero-art svg { width: 100%; height: auto; display: block; filter: drop-shadow(0 20px 40px rgba(15, 23, 42, 0.12)); }

  /* Floating shapes */
  .float { animation: floaty 6s ease-in-out infinite; }
  .float-2 { animation: floaty 6s ease-in-out infinite; animation-delay: -2s; }
  .float-3 { animation: floaty 6s ease-in-out infinite; animation-delay: -4s; }

  @keyframes floaty {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  /* ============ MAIN CONTENT - DARK THEME ============ */
  .container {
    max-width: 1000px;
    margin: -80px auto 0;
    padding: 0 20px 40px;
    position: relative;
    z-index: 3;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    margin-bottom: 24px;
  }

  .card {
    background: var(--card-dark);
    border: 1px solid var(--border-dark);
    border-radius: 18px;
    padding: 26px;
    position: relative;
    overflow: hidden;
    transition: transform .2s ease, border-color .2s ease;
  }

  .card::before {
    content: "";
    position: absolute;
    top: -50%;
    right: -30%;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.12), transparent 70%);
    pointer-events: none;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: rgba(56, 189, 248, 0.4);
  }

  .card-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(56,189,248,0.2), rgba(129,140,248,0.2));
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    border: 1px solid rgba(56, 189, 248, 0.25);
  }

  .card-icon svg { width: 26px; height: 26px; }

  .card h3 {
    color: var(--accent);
    font-size: 1.1rem;
    margin-bottom: 10px;
    font-weight: 800;
  }

  .card p {
    color: var(--muted-dark);
    font-size: 0.92rem;
    line-height: 1.85;
  }

  /* Wide card */
  .card-wide {
    grid-column: 1 / -1;
  }

  .card-wide p {
    color: var(--text-dark);
    font-size: 0.95rem;
    margin-bottom: 12px;
  }

  /* Games list */
  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    margin-top: 16px;
  }

  .game-item {
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid var(--border-dark);
    border-radius: 12px;
    padding: 14px;
    text-align: center;
    transition: .2s;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .game-item:hover {
    border-color: var(--accent);
    background: rgba(56, 189, 248, 0.06);
  }

  .game-item svg { width: 32px; height: 32px; }

  .game-item span {
    font-size: 0.82rem;
    color: var(--text-dark);
    font-weight: 600;
  }

  /* Contact strip */
  .contact-strip {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.08), rgba(129, 140, 248, 0.08));
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 18px;
    padding: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .contact-strip .info h3 {
    color: var(--accent);
    font-size: 1.15rem;
    margin-bottom: 6px;
  }

  .contact-strip .info p {
    color: var(--muted-dark);
    font-size: 0.9rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .contact-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-dark);
    padding: 10px 16px;
    border-radius: 10px;
    font-size: 0.88rem;
    transition: .2s;
  }

  .contact-chip:hover {
    border-color: var(--accent);
    background: rgba(56, 189, 248, 0.08);
  }

  .contact-chip svg { width: 18px; height: 18px; }

  /* Footer */
  footer {
    text-align: center;
    color: var(--muted-dark);
    font-size: 0.82rem;
    padding: 30px 20px 40px;
    border-top: 1px solid var(--border-dark);
    margin-top: 20px;
  }

  footer .made {
    color: var(--accent);
    font-weight: bold;
  }

  /* Decorative divider between white and dark */
  .divider {
    position: relative;
    height: 80px;
    background: linear-gradient(180deg, #f1f5f9, #0f172a);
    margin-top: -1px;
  }

  @media (max-width: 640px) {
    .hero { padding: 40px 16px 120px; }
    .hero h1 { font-size: 1.6rem; }
    .container { margin-top: -100px; }
    .contact-strip { flex-direction: column; text-align: center; }
    .contact-links { justify-content: center; }
  }
</style>
</head>
